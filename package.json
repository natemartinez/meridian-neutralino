{
  "name": "meridian",
  "version": "1.0.0",
  "private": true,
  "description": "Visual goal navigation powered by AI",
  "author": "Meridian <dev@meridian.app>",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "productivity",
    "goals",
    "goal-tracking",
    "neutralinojs",
    "react",
    "vite",
    "ai-companion",
    "openrouter",
    "pomodoro",
    "skill-tracking",
    "personal-dashboard"
  ],
  "scripts": {
    "prebuild": "bash scripts/validate-config.sh",
    "dev": "vite",
    "build": "vite build",
    "predist": "bash scripts/validate-config.sh",
    "start": "npx neu run",
    "dist": "vite build && mkdir -p resources && npx neu build --release",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "format": "prettier --write src/"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@neutralinojs/neu": "^11.7.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.4",
    "vite": "^8.0.9",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@neutralinojs/lib": "^6.8.0",
    "@tiptap/pm": "^3.22.5",
    "@tiptap/react": "^3.22.5",
    "@tiptap/starter-kit": "^3.22.5",
    "better-sqlite3": "^12.11.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "zustand": "^5.0.14"
  }
}
